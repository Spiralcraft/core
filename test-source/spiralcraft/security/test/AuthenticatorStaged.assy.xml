<!-- Password module followed by a dependent code module. The code module
     is a test double for the second factor: it finds the account from the
     group's identified principal, passes when the account has no
     secondFactorList, and otherwise requires the fixed code 246810 (no
     Ticket involved). It exercises staging, identity context and the
     group's reset rule, not code issuance. -->
<secauth:Authenticator
  xmlns:sec="class:/spiralcraft/security/"
  xmlns:secauth="class:/spiralcraft/security/auth/"
  xmlns:secspi="class:/spiralcraft/security/spi/"
  xmlns:query="class:/spiralcraft/data/query/"
  xmlns:j="class:/java/lang/"
  >
  <debug>true
  </debug>
  
  <!-- Same realm as Authenticator.assy.xml: the realm salts the digests
       the test data and assertions use -->
  <realmName>example@example.com
  </realmName>

  <authModules>
    <secspi:AuthModuleGroup>
      <name>mfa
      </name>
      <modules>
      <secspi:PasswordDataAuthModule>
        <name>local
        </name>
        <debug>true
        </debug>
      </secspi:PasswordDataAuthModule>

        <secspi:DataAuthModule
          xmlns:auth="class:/spiralcraft/security/auth/"
          >
          <name>code
          </name>
          <debug>true
          </debug>
          
          <acceptedCredentials>
            <j:Class>spiralcraft.security.auth.OneTimeCodeCredential
            </j:Class>
          </acceptedCredentials>
          
          <accountQuery 
            x="[*query:Selection
                 {[*query:Scan{[@sec:Login].type}]
                 ,`.principalId==[auth:ModuleSessionContext].identifiedPrincipal.id`
                 }
               ]
              "
          />
          
          <credentialValidators>
            <!-- No second factor configured for the account -->
            <secspi:BasicCredentialValidator>
              <whenX>.secondFactorList==null 
                || .secondFactorList.trim().length()==0
              </whenX>
              <validationX>true
              </validationX>
            </secspi:BasicCredentialValidator>
            
            <!-- Second factor configured: the fixed test code -->
            <secspi:BasicCredentialValidator>
              <whenX>.secondFactorList!=null 
                &amp;&amp; .secondFactorList.trim().length()&gt;0
              </whenX>
              <validationX>OneTimeCodeCredential=="246810"
              </validationX>
            </secspi:BasicCredentialValidator>
          </credentialValidators>
        </secspi:DataAuthModule>
      </modules>
    </secspi:AuthModuleGroup>
  </authModules>
  
  <authorizer>
    <secspi:DataAuthorizer>
      <principalType x="[@sec:Login].type"/>
      
      <principalNameFieldName>username
      </principalNameFieldName>
      
      <principalIdFieldName>principalId
      </principalIdFieldName>
      
      <registeredRoles dataURI="secspi:StandardRoles.data.xml"/>
      
      <roleBindings>(searchname!="denied")?[@secauth:SignedInRole].typeURI:null      
      </roleBindings>
      
    </secspi:DataAuthorizer>
  </authorizer>

</secauth:Authenticator>
