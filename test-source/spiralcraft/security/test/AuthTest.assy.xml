<!-- Security tests: one Reference per Authenticator configuration -->
<test:TestGroup
  xmlns:test="class:/spiralcraft/test/"
  >
  <name>spiralcraft.security.test
  </name>
  
  <sequence>
    <test:TestGroup>
      <name>AuthBasic
      </name>
      <sequence>
        <AuthBasicTest/>
      </sequence>
    </test:TestGroup>

    <test:TestGroup>
      <name>AuthGroup
      </name>
      <sequence>
        <AuthGroupTest/>
      </sequence>
    </test:TestGroup>
    <test:TestGroup>
      <name>AuthGroupGate
      </name>
      <sequence>
        <AuthGroupGateTest/>
      </sequence>
    </test:TestGroup>
    <test:TestGroup>
      <name>AuthGroupMismatch
      </name>
      <sequence>
        <AuthGroupMismatchTest/>
      </sequence>
    </test:TestGroup>
    <test:TestGroup>
      <name>AuthStaged
      </name>
      <sequence>
        <AuthStagedTest/>
      </sequence>
    </test:TestGroup>
  </sequence>
        
</test:TestGroup>