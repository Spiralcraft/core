<task:Sequence
  xmlns:task="class:/spiralcraft/task/"
  xmlns:test="class:/spiralcraft/test/"
  xmlns:sr="class:/spiralcraft/rules/"
  >
  <scenarios>
    <test:Assertion>
      <name>Eval
      </name>
      <subjectX>[*task:Eval{ `{x:=2,y:=5}` , `x*y` }].()
      </subjectX>
      <testX>.==10
      </testX>
    </test:Assertion>
    
    <task:Cycle>
    
      <contextX>[#context] { count:=0 }
      </contextX>

      <maxCycles>3
      </maxCycles>
      
      <sequence>
        <test:Assertion>
        
          <name>Cycle
          </name>
          <subjectX>([context].count=[context].count+1).@log("Cycling"+[context])
          </subjectX>
          <testX>true
          </testX>
      
        </test:Assertion>
      
      </sequence>
    </task:Cycle>    
    
    <task:Sequence>

        
      <contextX>
        [#context] 
        {
          count:=0
          ,increment:~[*task:Eval{`.count=.count+1`}]
        }
      </contextX>
    

      <scenarios>
        <task:Fork>
          
          <scenarios>
            <test:Assertion>
            
              <name>Fork #1
              </name>
              <subjectX>[context].increment().@log("Fork #1: "+[context].count)
              </subjectX>
              <testX>true
              </testX>
          
            </test:Assertion>
            
            <test:Assertion>
            
              <name>Fork #2
              </name>
              <subjectX>[context].increment().@log("Fork #2: "+[context].count)
              </subjectX>
              <testX>true
              </testX>
          
            </test:Assertion>
            
            <test:Assertion>
            
              <name>Fork #3
              </name>
              <subjectX>[context].increment().@log("Fork #3: "+[context].count)
              </subjectX>
              <testX>true
              </testX>
          
            </test:Assertion>  
                        
          </scenarios>
        </task:Fork>    
        <test:Assertion>
        
          <name>Fork
          </name>
          <subjectX>[context].count
          </subjectX>
          <testX>.==3
          </testX>
      
        </test:Assertion>  
        
        <task:If>
          <x>true
          </x>
          <sequence>
            <test:Assertion>
        
              <name>If legacy
              </name>
              <subjectX>.
              </subjectX>
              <testX>true
              </testX>
            </test:Assertion>  
          </sequence>
        </task:If>
        
        <task:If>
          <x>true
          </x>
          <then>
            <test:Assertion>
        
              <name>If true
              </name>
              <subjectX>.
              </subjectX>
              <testX>true
              </testX>
            </test:Assertion>  
          </then>
          <else>
            <test:Assertion>
        
              <name>If true FAIL
              </name>
              <subjectX>.
              </subjectX>
              <testX>false
              </testX>
            </test:Assertion>  
          </else>
        </task:If>
        
        <task:If>
          <x>false
          </x>
          <then>
            <test:Assertion>
        
              <name>If false FAIL
              </name>
              <subjectX>.
              </subjectX>
              <testX>false
              </testX>
            </test:Assertion>  
          </then>
          <else>
            <test:Assertion>
        
              <name>If false
              </name>
              <subjectX>.
              </subjectX>
              <testX>true
              </testX>
            </test:Assertion>  
          </else>
        </task:If>

        <task:Switch>
          <x>"b"
          </x>
          <cases>
            <task:Case>
              <constant>a
              </constant>
              <sequence>
                <test:Assertion>
                  <name>Switch a FAIL
                  </name>
                  <subjectX>.
                  </subjectX>
                  <testX>false
                  </testX>
                </test:Assertion>
              </sequence>
            </task:Case>
            <task:Case>
              <constant>b
              </constant>
              <sequence>
                <test:Assertion>
                  <name>Switch matches its case
                  </name>
                  <subjectX>.
                  </subjectX>
                  <testX>true
                  </testX>
                </test:Assertion>
              </sequence>
            </task:Case>
            <task:Case>
              <default>true
              </default>
              <sequence>
                <test:Assertion>
                  <name>Switch default FAIL
                  </name>
                  <subjectX>.
                  </subjectX>
                  <testX>false
                  </testX>
                </test:Assertion>
              </sequence>
            </task:Case>
          </cases>
        </task:Switch>

        <task:Switch>
          <x>"z"
          </x>
          <cases>
            <task:Case>
              <constant>a
              </constant>
              <sequence>
                <test:Assertion>
                  <name>Switch a FAIL
                  </name>
                  <subjectX>.
                  </subjectX>
                  <testX>false
                  </testX>
                </test:Assertion>
              </sequence>
            </task:Case>
            <task:Case>
              <default>true
              </default>
              <sequence>
                <test:Assertion>
                  <name>Switch default on no match
                  </name>
                  <subjectX>.
                  </subjectX>
                  <testX>true
                  </testX>
                </test:Assertion>
              </sequence>
            </task:Case>
          </cases>
        </task:Switch>

        <task:Switch>
          <x>"z"
          </x>
          <cases>
            <task:Case>
              <constant>a
              </constant>
              <sequence>
                <test:Assertion>
                  <name>Switch no default FAIL
                  </name>
                  <subjectX>.
                  </subjectX>
                  <testX>false
                  </testX>
                </test:Assertion>
              </sequence>
            </task:Case>
          </cases>
        </task:Switch>

        <task:Switch>
          <x>2
          </x>
          <cases>
            <task:Case>
              <constant>1
              </constant>
              <sequence>
                <test:Assertion>
                  <name>Switch integer 1 FAIL
                  </name>
                  <subjectX>.
                  </subjectX>
                  <testX>false
                  </testX>
                </test:Assertion>
              </sequence>
            </task:Case>
            <task:Case>
              <constant>2
              </constant>
              <sequence>
                <test:Assertion>
                  <name>Switch converts a text constant
                  </name>
                  <subjectX>.
                  </subjectX>
                  <testX>true
                  </testX>
                </test:Assertion>
              </sequence>
            </task:Case>
          </cases>
        </task:Switch>

        <task:Switch>
          <x>2
          </x>
          <cases>
            <task:Case>
              <constant>1
              </constant>
              <sequence>
                <test:Assertion>
                  <name>Switch constantX FAIL
                  </name>
                  <subjectX>.
                  </subjectX>
                  <testX>false
                  </testX>
                </test:Assertion>
              </sequence>
            </task:Case>
            <task:Case>
              <constantX>1+1
              </constantX>
              <sequence>
                <test:Assertion>
                  <name>Switch evaluates constantX
                  </name>
                  <subjectX>.
                  </subjectX>
                  <testX>true
                  </testX>
                </test:Assertion>
              </sequence>
            </task:Case>
          </cases>
        </task:Switch>
        
        <task:If>
          <x>true
          </x>
          <then>
            @log("Auto Eval")
          </then>
          <else>
            @log("Auto Eval FAIL")
          </else>
        </task:If>
        
        <test:AssertFailure>
          <name>Validation Fail test
          </name>
          <chain>
            <task:Validate>
              <rules>
                <sr:ExpressionRule>
                  <x>false
                  </x>
                  <message>Validation fail asserted
                  </message>
                </sr:ExpressionRule>
              </rules>
            
            
            </task:Validate>
          
          </chain>
        
        </test:AssertFailure>
        
        <task:Validate>
          <rules>
            <sr:ExpressionRule>
              <x>true
              </x>
              <message>This can't happen               
              </message>
            </sr:ExpressionRule>
          </rules>
         
         
        </task:Validate>
          
        
      </scenarios>   
    </task:Sequence>
  </scenarios>
</task:Sequence>